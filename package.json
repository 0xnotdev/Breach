{
  "name": "breach",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:web": "npm run test --workspace @breach/web",
    "test:browser": "npm run test:browser --workspace @breach/web",
    "test:integration": "node scripts/controlled-full-stack.mjs",
    "test:watch": "vitest",
    "audit:dependencies": "npm audit --omit=dev --audit-level=high",
    "audit:secrets": "node scripts/audit-tracked-secrets.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build && npm run test:web && npm run test:browser && npm run audit:dependencies && npm run audit:secrets"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.33.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.1",
    "vitest": "^3.2.4"
  }
}
