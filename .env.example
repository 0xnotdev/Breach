# GitHub fine-grained read-only token: public repository metadata and contents only.
GITHUB_TOKEN=replace-with-read-only-github-token
# Default live-only mode snapshots the current repository frontier and never backfills history.
DISCOVERY_MODE=live
CANDIDATE_MINIMUM_SCORE=60
TARGET_SELECTION_RATIO=0.07
# Generate independently: at least 32 random bytes. Never reuse the operator token.
FINGERPRINT_HMAC_KEY=replace-with-32-or-more-random-bytes
# Private-console bearer token: at least 16 random bytes.
OPERATOR_TOKEN=replace-with-private-operator-token
POSTGRES_PASSWORD=replace-with-local-database-password
API_PORT=8080
WORKER_HEALTH_PORT=8081
POLL_INTERVAL_MS=30000
